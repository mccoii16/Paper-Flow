# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server-Side Meta Messenger Integration (Never expose in frontend code)
META_APP_ID=""
META_APP_SECRET=""
META_PAGE_ACCESS_TOKEN=""
META_VERIFY_TOKEN=""
META_PAGE_ID=""

# Target Firestore Workspace Document ID for incoming Meta webhooks
PAPERFLOW_WORKSPACE_ID="paper-dreams-cebu"

# Optional for non-GCP hosts (e.g. Vercel): minified Firebase Admin service account JSON
# Leave blank in AI Studio / Cloud Run where Application Default Credentials are used.
FIREBASE_SERVICE_ACCOUNT_JSON=""
